<%# Hero visual: rak gantung 7 pakaian dengan plastik PP hanger bersablon (interaktif, lihat public/js/hanger-rack.js) %>
<div class="hero-visual rack-visual" data-rack data-phone="<%= site.whatsappDisplay.replace(/^\+62\s?/, '0').replace(/-/g, ' ') %>">
  <div class="floor"></div>
  <svg class="rack-svg" viewBox="0 0 540 470" role="img" aria-label="Rak gantung berisi gaun, kemeja, dan celana yang dibungkus plastik PP hanger bersablon logo <%= site.name %>">
    <defs>
      <!-- Champagne-gold metal for rack + hangers -->
      <linearGradient id="metal" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#fff4dc"/><stop offset=".35" stop-color="#e2c48d"/><stop offset=".65" stop-color="#a8844c"/><stop offset="1" stop-color="#f3dfb2"/>
      </linearGradient>
      <linearGradient id="gold" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#8a6a36"/><stop offset=".2" stop-color="#f7e6bf"/><stop offset=".5" stop-color="#c9a160"/>
        <stop offset=".8" stop-color="#f2dcaa"/><stop offset="1" stop-color="#8a6a36"/>
      </linearGradient>
      <linearGradient id="goldV" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#fff6e0"/><stop offset=".5" stop-color="#d4b071"/><stop offset="1" stop-color="#8a6a36"/>
      </linearGradient>
      <linearGradient id="wood" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#c79a6c"/><stop offset=".55" stop-color="#9a6c45"/><stop offset="1" stop-color="#5e3d24"/>
      </linearGradient>
      <radialGradient id="floorShadow" cx=".5" cy=".5" r=".5">
        <stop offset="0" stop-color="#000" stop-opacity=".55"/><stop offset="1" stop-color="#000" stop-opacity="0"/>
      </radialGradient>
      <linearGradient id="shade" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#000" stop-opacity=".32"/><stop offset=".3" stop-color="#000" stop-opacity="0"/>
        <stop offset=".7" stop-color="#000" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity=".34"/>
      </linearGradient>
      <linearGradient id="bagFill" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#f4f8ff" stop-opacity=".5"/><stop offset=".5" stop-color="#e6f2ff" stop-opacity=".34"/><stop offset="1" stop-color="#f4f8ff" stop-opacity=".46"/>
      </linearGradient>
      <linearGradient id="sheenGrad" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#fff" stop-opacity="0"/><stop offset=".5" stop-color="#fff" stop-opacity=".5"/><stop offset="1" stop-color="#fff" stop-opacity="0"/>
      </linearGradient>
      <!-- Brand logo (same as /img/logo.svg) -->
      <linearGradient id="logoA" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffffff"/><stop offset="1" stop-color="#c9bfff"/></linearGradient>
      <linearGradient id="logoB" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#8b7bff"/><stop offset="1" stop-color="#ff5fa8"/></linearGradient>
      <symbol id="logoMark" viewBox="0 0 64 64">
        <path d="M8 10h26c8 0 12 5 12 11 0 4-2 7-5 9L8 30z" fill="url(#logoA)"/>
        <path d="M56 54H30c-8 0-12-5-12-11 0-4 2-7 5-9l33 0z" fill="url(#logoB)"/>
      </symbol>
      <!-- Single-ink version for the screen print (colour comes from the parent's `color`) -->
      <symbol id="logoInk" viewBox="0 0 64 64">
        <path d="M8 10h26c8 0 12 5 12 11 0 4-2 7-5 9L8 30z" fill="currentColor"/>
        <path d="M56 54H30c-8 0-12-5-12-11 0-4 2-7 5-9l33 0z" fill="currentColor"/>
      </symbol>
    </defs>

    <!-- Rack (penyangga): rounded champagne-gold arch frame + walnut shelf -->
    <g>
      <ellipse cx="270" cy="458" rx="250" ry="12" fill="url(#floorShadow)"/>

      <g transform="translate(270 22)">
        <path d="M-40 6 L-30 28 M40 6 L30 28" stroke="url(#metal)" stroke-width="1.6"/>
        <rect x="-74" y="-14" width="148" height="26" rx="13" fill="#120a1f" stroke="url(#gold)" stroke-width="1.6"/>
        <use href="#logoMark" x="-64" y="-9" width="16" height="16"/>
        <text x="-43" y="4" font-family="Plus Jakarta Sans, sans-serif" font-size="11" font-weight="700" letter-spacing=".1em" fill="#f3e3bd"><%= site.name.toUpperCase() %></text>
      </g>

      <path d="M30 446 L40 96 Q42 50 88 50 H452 Q498 50 500 96 L510 446" fill="none" stroke="url(#gold)" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M40 96 Q42 50 88 50 H452 Q498 50 500 96" fill="none" stroke="#fff8e6" stroke-opacity=".55" stroke-width="1.6" transform="translate(0 -2)"/>

      <path d="M34 404 H506" stroke="url(#gold)" stroke-width="4" stroke-linecap="round"/>
      <rect x="40" y="392" width="460" height="12" rx="4" fill="url(#wood)"/>
      <path d="M44 394 H496" stroke="#fff" stroke-opacity=".25" stroke-width="1"/>

      <g transform="translate(408 392)">
        <rect x="-2" y="-10" width="46" height="10" rx="2" fill="#dff1ff" fill-opacity=".22" stroke="#fff" stroke-opacity=".5"/>
        <rect x="2" y="-19" width="42" height="9" rx="2" fill="#dff1ff" fill-opacity=".18" stroke="#fff" stroke-opacity=".45"/>
        <rect x="0" y="-27" width="44" height="8" rx="2" fill="#dff1ff" fill-opacity=".22" stroke="#fff" stroke-opacity=".5"/>
      </g>
      <g transform="translate(92 392)">
        <path d="M6 -40 Q6 -54 16 -54 Q26 -54 26 -40" fill="none" stroke="#c9b6ff" stroke-width="2.4"/>
        <path d="M0 -42 H32 L34 0 H-2 Z" fill="#6d5bff"/>
        <path d="M0 -42 H32 L34 0 H-2 Z" fill="url(#shade)"/>
        <use href="#logoMark" x="8" y="-30" width="16" height="16"/>
      </g>

      <circle cx="30" cy="450" r="6" fill="url(#goldV)"/><circle cx="510" cy="450" r="6" fill="url(#goldV)"/>
    </g>

    <!-- Garments + bags are generated by hanger-rack.js -->
    <g data-garments></g>
  </svg>

  <span class="hotspot h1"><span class="pulse"></span> Lubang Hanger</span>
  <span class="hotspot h3"><span class="pulse"></span> Sablon 1 Warna</span>
  <span class="hotspot h2"><span class="pulse"></span> Gaun · Kemeja · Celana</span>
  <span class="drag-hint" aria-hidden="true">↔ Sentuh / tarik pakaiannya</span>
</div>
<script src="/js/hanger-rack.js?v=<%= assetVersion %>" defer></script>
