<header class="site-header" data-header>
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="<%= site.name %> – Beranda">
      <img src="/img/logo.svg" alt="" width="30" height="30">
      <span><%= site.name %></span>
    </a>

    <nav class="main-nav" id="main-nav" aria-label="Menu utama" data-nav>
      <ul>
        <% nav.forEach(function (item) {
          const active = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href); %>
          <li><a href="<%= item.href %>" class="<%= active ? 'is-active' : '' %>" <% if (active) { %>aria-current="page"<% } %>><%= item.label %></a></li>
        <% }) %>
      </ul>
      <a class="btn btn-violet nav-cta-mobile" href="<%= site.whatsappLink() %>" target="_blank" rel="noopener">
        <%- include('icon', { name: 'whatsapp', s: 18 }) %> Minta Penawaran
      </a>
    </nav>

    <a class="btn btn-violet header-cta" href="<%= site.whatsappLink() %>" target="_blank" rel="noopener">Pesan Sekarang</a>

    <button class="nav-toggle" type="button" aria-controls="main-nav" aria-expanded="false" aria-label="Buka menu" data-nav-toggle>
      <span class="nav-toggle-open"><%- include('icon', { name: 'menu', s: 24 }) %></span>
      <span class="nav-toggle-close"><%- include('icon', { name: 'close', s: 24 }) %></span>
    </button>
  </div>
</header>
