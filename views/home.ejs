<%- include('partials/head') %>

<!-- ============ HERO ============ -->
<section class="hero" aria-labelledby="hero-title">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-copy">
        <h1 id="hero-title" class="display">Kemas<br>Lebih Kuat</h1>
        <p class="lead"><strong><%= site.name %></strong> memproduksi kantong plastik HD dan PP — polos maupun sablon logo — untuk toko, UMKM, dan industri di Jabodetabek.</p>
        <div class="hero-actions">
          <a class="btn btn-white btn-lg" href="<%= site.whatsappLink() %>" target="_blank" rel="noopener">Minta Penawaran</a>
          <a class="btn btn-ghost btn-lg" href="/produk">Lihat Produk</a>
        </div>
      </div>

      <%- include('partials/hanger-rack') %>
    </div>

    <div class="bento">
      <article class="card bento-photo reveal">
        <div class="bars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
        <span class="tag">Plastik HD</span>
        <img class="bento-img" src="/img/produk-kresek-hd.svg" alt="" width="300" height="340" loading="lazy">
        <h3>Kuat untuk beban berat</h3>
      </article>

      <article class="card bento-violet reveal">
        <div class="orbit" aria-hidden="true"></div>
        <div>
          <small><%- include('partials/icon', { name: 'sparkle', s: 16 }) %> Food Grade</small>
          <h3>Plastik PP bening untuk kemasan makanan</h3>
        </div>
      </article>

      <div class="bento-play reveal">
        <a class="play-stack" href="/tentang" aria-label="Kenali SONINDOGRAFIKA">
          <span class="p1"><%- include('partials/icon', { name: 'play', s: 24 }) %></span><span class="p2"></span>
        </a>
        <p>Ingin tahu lebih banyak?</p>
        <a href="/tentang">Kenali Kami</a>
      </div>
    </div>
  </div>
</section>

<!-- ============ STATS ============ -->
<section aria-label="Angka SONINDOGRAFIKA">
  <div class="container">
    <div class="stats-strip reveal">
      <% site.stats.forEach(function (s) { %><div><strong><%= s.value %></strong><span><%= s.label %></span></div><% }) %>
      <div><strong>5 Kota</strong><span>Area layanan Jabodetabek</span></div>
    </div>
  </div>
</section>

<!-- ============ ABOUT SHORT ============ -->
<section class="section" aria-labelledby="about-title">
  <div class="container split">
    <div class="card split-visual reveal">
      <img src="/img/produk-custom.svg" alt="Kantong plastik sablon logo custom" width="300" height="340" loading="lazy">
    </div>
    <div class="reveal">
      <span class="eyebrow">Tentang Kami</span>
      <h2 id="about-title" class="h-section" style="margin-top:18px">Mitra kemasan plastik <em>untuk usaha Anda</em></h2>
      <p class="lead" style="margin-top:20px"><%= site.name %> adalah produsen kantong plastik berbahan <strong>HD (HDPE)</strong> dan <strong>PP (polypropylene)</strong>. Kami membantu toko, UMKM, restoran, laundry, hingga industri mendapatkan kemasan yang kuat, rapi, dan sesuai identitas brand — dengan harga langsung dari produsen.</p>
      <ul class="check-list">
        <li><%- include('partials/icon', { name: 'check' }) %> Produksi plastik polos &amp; sablon custom</li>
        <li><%- include('partials/icon', { name: 'check' }) %> Melayani pesanan grosir dan repeat order</li>
        <li><%- include('partials/icon', { name: 'check' }) %> Pengiriman ke seluruh Jabodetabek</li>
      </ul>
      <a class="link-arrow" href="/tentang">Selengkapnya tentang kami <%- include('partials/icon', { name: 'arrow', s: 18 }) %></a>
    </div>
  </div>
</section>

<!-- ============ PRODUCT PREVIEW ============ -->
<section class="section" style="padding-top:0" aria-labelledby="produk-title">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow">Produk Kami</span>
        <h2 id="produk-title" class="h-section" style="margin-top:18px">Pilihan plastik <em>HD &amp; PP</em></h2>
        <p class="lead">Dari kantong kresek belanja sampai plastik bening untuk kemasan makanan.</p>
      </div>
      <a class="btn btn-ghost" href="/produk">Semua Produk <%- include('partials/icon', { name: 'arrow', s: 18 }) %></a>
    </div>
    <div class="product-grid">
      <% products.forEach(function (p) { %><%- include('partials/product-card', { p: p }) %><% }) %>
    </div>

    <div class="material-grid" style="margin-top:24px">
      <% Object.values(materials).forEach(function (m) { %>
      <article class="card material-card reveal">
        <div>
          <h3><%= m.name %></h3>
          <p class="sub"><%= m.fullName %></p>
          <p><%= m.summary %></p>
          <a class="link-arrow" href="/produk#<%= m.key %>">Kelebihan &amp; kegunaan <%- include('partials/icon', { name: 'arrow', s: 18 }) %></a>
        </div>
        <img src="/img/<%= m.key === 'hd' ? 'produk-kresek-hd' : 'produk-pp-bening' %>.svg" alt="" width="140" height="160" loading="lazy">
      </article>
      <% }) %>
    </div>
  </div>
</section>

<!-- ============ WHY US ============ -->
<section class="section" style="padding-top:0" aria-labelledby="why-title">
  <div class="container">
    <div class="section-head center">
      <span class="eyebrow">Kenapa Memilih Kami</span>
      <h2 id="why-title" class="h-section" style="margin-top:18px">Alasan pelaku usaha <em>percaya</em> pada kami</h2>
      <p class="lead">Kualitas, harga, dan layanan yang dirancang untuk kebutuhan usaha di Jabodetabek.</p>
    </div>
    <%- include('partials/why-us') %>
  </div>
</section>

<!-- ============ PROCESS ============ -->
<section class="section" style="padding-top:0" aria-labelledby="proses-title">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow">Cara Pesan</span>
        <h2 id="proses-title" class="h-section" style="margin-top:18px">Pesan mudah dalam <em>4 langkah</em></h2>
      </div>
    </div>
    <ol class="steps">
      <li class="card step reveal"><div class="feature-icon"><%- include('partials/icon', { name: 'chat', s: 22 }) %></div><h3>Konsultasi</h3><p>Ceritakan produk dan kebutuhan kemasan Anda via WhatsApp.</p></li>
      <li class="card step reveal"><div class="feature-icon"><%- include('partials/icon', { name: 'ruler', s: 22 }) %></div><h3>Tentukan Spesifikasi</h3><p>Pilih bahan, ukuran, ketebalan, warna, dan desain sablon.</p></li>
      <li class="card step reveal"><div class="feature-icon"><%- include('partials/icon', { name: 'factory', s: 22 }) %></div><h3>Produksi</h3><p>Setelah penawaran &amp; desain disetujui, pesanan langsung diproduksi.</p></li>
      <li class="card step reveal"><div class="feature-icon"><%- include('partials/icon', { name: 'truck', s: 22 }) %></div><h3>Pengiriman</h3><p>Pesanan dikirim ke alamat Anda di seluruh Jabodetabek.</p></li>
    </ol>
  </div>
</section>

<!-- ============ CTA ============ -->
<section class="section" style="padding-top:0" aria-labelledby="cta-title">
  <div class="container">
    <div class="card cta-band reveal">
      <div>
        <h2 id="cta-title" class="h-section">Siap upgrade kemasan usaha Anda?</h2>
        <p>Dapatkan penawaran harga dan rekomendasi bahan secara gratis. Kami biasanya membalas dalam hitungan jam.</p>
      </div>
      <div class="actions">
        <a class="btn btn-white btn-lg" href="<%= site.whatsappLink() %>" target="_blank" rel="noopener"><%- include('partials/icon', { name: 'whatsapp', s: 20 }) %> Chat WhatsApp</a>
        <a class="btn btn-ghost btn-lg" href="/kontak">Kontak Lainnya</a>
      </div>
    </div>
  </div>
</section>

<!-- ============ ARTICLES ============ -->
<section class="section" style="padding-top:0" aria-labelledby="artikel-title">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow">Artikel</span>
        <h2 id="artikel-title" class="h-section" style="margin-top:18px">Panduan <em>plastik kemasan</em></h2>
      </div>
      <a class="btn btn-ghost" href="/artikel">Semua Artikel <%- include('partials/icon', { name: 'arrow', s: 18 }) %></a>
    </div>
    <div class="article-grid">
      <% articles.forEach(function (a) { %><%- include('partials/article-card', { a: a }) %><% }) %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
